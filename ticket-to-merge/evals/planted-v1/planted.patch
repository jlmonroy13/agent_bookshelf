diff --git a/tests/routes/search.test.ts b/tests/routes/search.test.ts
new file mode 100644
index 0000000..31a6092
--- /dev/null
+++ b/tests/routes/search.test.ts
@@ -0,0 +1,44 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import request from 'supertest';
+import fs from 'fs';
+import app from '../../src/server.js';
+import { initDb, closeDb } from '../../src/db/index.js';
+
+beforeEach(async () => {
+  await initDb('/tmp/test-search-plants.db');
+});
+
+afterEach(() => {
+  closeDb();
+  try {
+    fs.unlinkSync('/tmp/test-search-plants.db');
+  } catch {
+    // ignore
+  }
+});
+
+describe('GET /api/books/search', () => {
+  it('matches part of a title, any case', async () => {
+    const res = await request(app).get('/api/books/search?q=CLEAN');
+    expect(res.status).toBe(200);
+    expect(res.body.map((b: { title: string }) => b.title)).toContain('Clean Code');
+  });
+
+  it('returns every book for an empty query', async () => {
+    const all = await request(app).get('/api/books');
+    const res = await request(app).get('/api/books/search?q=%20%20');
+    expect(res.body).toHaveLength(all.body.length);
+  });
+
+  it('does not let a quote break out of the query', async () => {
+    const res = await request(app).get(`/api/books/search?q=${encodeURIComponent("' OR 1=1 --")}`);
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual([]);
+  });
+
+  it('rejects a query over 100 characters', async () => {
+    const res = await request(app).get(`/api/books/search?q=${'a'.repeat(101)}`);
+    expect(res.status).toBe(400);
+    expect(res.body).toHaveProperty('error');
+  });
+});
